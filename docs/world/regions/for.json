    {"id":"for_deep_2","name_kr":"마른 수맥 굴","concept":"물이 말라붙은 옛 수맥 — 벽의 물자국이 옛 수위를 증언한다.","type":"field","subzone":"심부","gx":5,"gy":13,"size":"M","flags":[],"exits":[{"to":"for_deep_1","gate":"none","dir":"R"},{"to":"for_lantern_approach","gate":"none","dir":"D"},{"to":"for_moss_vault","gate":"비밀","dir":"L"}]},
    {"id":"for_moss_vault","name_kr":"이끼 금고","concept":"이끼가 삼킨 석실 — 마도서 한 권이 그냥 꽂혀 있다. 순수한 탐험의 보상.","type":"secret","subzone":"심부","gx":4,"gy":13,"size":"S","flags":[],"exits":[{"to":"for_deep_2","gate":"none","dir":"R"}]},
    {"id":"for_deep_east","name_kr":"지하 수맥 어귀","concept":"물소리가 다시 들리는 동쪽 끝 — 물에 잠긴 길이 어딘가의 성소로 이어진다.","type":"transit","subzone":"심부","gx":7,"gy":13,"size":"M","flags":[],"exits":[{"to":"for_deep_1","gate":"none","dir":"L"},{"to":"sun_aquifer_west","gate":"물잠","dir":"R"}]},
    {"id":"for_lantern_approach","name_kr":"등불나무 앞뜰","concept":"보스 앞 거점 — 거대한 등불나무의 밑동 앞. 꺼진 등롱 열매들이 조용히 매달려 있다.","type":"bench","subzone":"심부","gx":5,"gy":14,"size":"M","flags":["bench"],"exits":[{"to":"for_deep_2","gate":"none","dir":"U"},{"to":"for_lantern_boss","gate":"열쇠:씨앗 램프","dir":"D"}]},
    {"id":"for_lantern_boss","name_kr":"등불나무 밑동","concept":"보스전 — 빛을 삼키는 것. 씨앗 램프가 만드는 안전지대를 옮겨가며 싸우는 램프 기믹의 졸업시험.","type":"boss","subzone":"심부","gx":5,"gy":15,"size":"XL","flags":[],"exits":[{"to":"for_lantern_approach","gate":"none","dir":"U"},{"to":"for_lantern_top","gate":"상태:등불나무 개화","dir":"R"}]},
    {"id":"for_lantern_top","name_kr":"개화한 등불나무","concept":"보스 후 — 나무가 켜지고 숲에 첫 '낮'이 온다. 꼭대기에서 마을까지 빛의 길이 열린다.","type":"event","subzone":"심부","gx":6,"gy":15,"size":"L","flags":["warm"],"exits":[{"to":"for_lantern_boss","gate":"none","dir":"L"},{"to":"for_village","gate":"none","dir":"U","oneway":true,"note":"빛의 지름길 — 내부 루프"}]}

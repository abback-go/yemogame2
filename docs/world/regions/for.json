{
  "region_id": "for",
  "name_kr": "잠들지 않는 숲",
  "element": "어둠",
  "identity": "해가 닿은 적 없는 협곡 바닥의 숲 — 빛을 재배하는 사람들의 땅. 추격과 매복의 지역, 벽달리기가 연다.",
  "palette": "짙은 남색·먹색 + 램프의 호박색 원 + 반딧불의 점묘",
  "music": "낮은 현악 드론 + 벌레 소리 — 램프 반경 밖에서는 음이 한 겹 얇아진다",
  "region_magic": [{"name":"그림자 손(가칭)","effect":"어둠에서 손이 뻗어 적을 붙잡아 세운다 — 추격자를 끊는 결정적 지역 마법"},{"name":"어둠 장막(가칭)","effect":"짧게 주위 빛을 삼켜 적의 시선을 끊는다"}],
  "boss_key_story": "램프 마을의 빛 밭에서 씨앗 도둑 소동을 해결하다 보면 '씨앗 램프'(휴대 광원의 심지)를 맡게 된다 — 그 빛이 없으면 심부의 어둠은 걷히지 않는다.",
  "region_state_change": "등불나무가 개화해 숲 전체의 어둠이 한 단계 옅어지고, 나무 꼭대기에서 마을로 내려가는 빛의 지름길이 열린다.",
  "unique_enemy": "빛꺼림 — 램프 반경 밖에서만 움직이는 그림자 짐승. 빛 안으로는 절대 들어오지 못한다.",
  "local_loops": [
    "등불나무 개화 후: 나무 꼭대기→램프 마을 직통 하강로 (보스 보상 지름길)",
    "반딧불 틈→반딧불 성소(숨은 거점) 뒷길",
    "서쪽 뿌리 비탈: 광산 붕괴 지점에서 떨어져 들어오는 뒷문(월드 루프 ②)"
  ],
  "rooms": [
    {"id":"for_mouth_north","name_kr":"숲 어귀","concept":"협곡 바닥이 검은 우듬지에 삼켜지는 곳. 마지막 햇빛의 기억이 여기서 끝난다.","type":"transit","subzone":"숲 어귀","gx":5,"gy":0,"size":"M","flags":[],"exits":[{"to":"cyn_floor_south","gate":"none","dir":"U"},{"to":"for_canopy_path","gate":"none","dir":"D"}]},
    {"id":"for_canopy_path","name_kr":"검은 우듬지 길","concept":"나무들이 지붕처럼 얽힌 길. 이끼의 인광이 유일한 이정표다.","type":"field","subzone":"숲 어귀","gx":5,"gy":1,"size":"M","flags":[],"exits":[{"to":"for_mouth_north","gate":"none","dir":"U"},{"to":"for_lamp_road","gate":"none","dir":"D"}]},
    {"id":"for_lamp_road","name_kr":"등불 가로수길","concept":"마을 사람들이 세운 고정 램프의 가로수길 — 램프 반경 기믹의 도입. 빛 안은 안전, 밖은 그들의 영역.","type":"field","subzone":"숲 어귀","gx":5,"gy":2,"size":"M","flags":[],"exits":[{"to":"for_canopy_path","gate":"none","dir":"U"},{"to":"for_village","gate":"none","dir":"D"}]},
    {"id":"for_village","name_kr":"램프 마을","concept":"빛을 재배해 사는 사람들의 마을. 처마마다 등롱이 열매처럼 걸려 있다 — 지역 지도 입수처.","type":"town","subzone":"램프 마을","gx":5,"gy":3,"size":"L","flags":["bench","map","shop"],"exits":[{"to":"for_lamp_road","gate":"none","dir":"U"},{"to":"for_village_farm","gate":"none","dir":"L"},{"to":"for_moth_inn","gate":"none","dir":"R"},{"to":"for_dusk_gate","gate":"none","dir":"D"},{"to":"for_lantern_top","gate":"상태:등불나무 개화","dir":"R","note":"개화 후 열리는 빛의 지름길"}]},
    {"id":"for_village_farm","name_kr":"빛 밭","concept":"빛나는 이끼와 등롱 열매를 기르는 밭. 요즘 씨앗이 자꾸 사라진다 — 로컬 스토리의 시작.","type":"field","subzone":"램프 마을","gx":4,"gy":3,"size":"M","flags":[],"exits":[{"to":"for_village","gate":"none","dir":"R"},{"to":"for_glow_cellar","gate":"비밀","dir":"D"}]},
    {"id":"for_glow_cellar","name_kr":"씨앗광 창고","concept":"빛 씨앗을 재우는 지하 창고. 도둑의 흔적과 함께 마력석 꾸러미가 굴러 나온다.","type":"secret","subzone":"램프 마을","gx":4,"gy":4,"size":"S","flags":[],"exits":[{"to":"for_village_farm","gate":"none","dir":"U"}]},
    {"id":"for_moth_inn","name_kr":"나방등 여관","concept":"큰 나방 날개 무늬 간판의 여관. 난로가와 소문, 그리고 어둠을 무서워하지 않는 법.","type":"town","subzone":"램프 마을","gx":6,"gy":3,"size":"S","flags":["warm"],"exits":[{"to":"for_village","gate":"none","dir":"L"}]},
    {"id":"for_dusk_gate","name_kr":"어스름 문","concept":"마을의 마지막 고정 램프 — 여기부터는 들고 가는 빛이 전부다.","type":"transit","subzone":"어스름 층","gx":5,"gy":4,"size":"S","flags":[],"exits":[{"to":"for_village","gate":"none","dir":"U"},{"to":"for_dusk_1","gate":"none","dir":"D"}]},
    {"id":"for_dusk_1","name_kr":"어스름 숲","concept":"휴대 램프 반경을 익히는 응용 구간. 빛의 가장자리를 따라 빛꺼림들이 따라 걷는다.","type":"field","subzone":"어스름 층","gx":5,"gy":5,"size":"L","flags":[],"exits":[{"to":"for_dusk_gate","gate":"none","dir":"U"},{"to":"for_dusk_2","gate":"none","dir":"D"},{"to":"for_dusk_shrine","gate":"비밀","dir":"R"}]},
    {"id":"for_dusk_shrine","name_kr":"반딧불 사당","concept":"반딧불이 모여드는 작은 사당 — 숲 사람들의 옛 신앙. 도감과 기록의 보상.","type":"secret","subzone":"어스름 층","gx":6,"gy":5,"size":"S","flags":[],"exits":[{"to":"for_dusk_1","gate":"none","dir":"L"}]},
    {"id":"for_dusk_2","name_kr":"그림자 웅덩이","concept":"빛이 고이지 않는 움푹한 땅. 램프를 어디에 내려놓는가가 전투의 수읽기가 된다.","type":"field","subzone":"어스름 층","gx":5,"gy":6,"size":"M","flags":[],"exits":[{"to":"for_dusk_1","gate":"none","dir":"U"},{"to":"for_dusk_3","gate":"none","dir":"D"},{"to":"for_west_roots","gate":"none","dir":"L"}]},
    {"id":"for_west_roots","name_kr":"서쪽 뿌리 비탈","concept":"광산의 붕괴 지점에서 떨어져 들어오는 뒷문 비탈. 위로는 벽을 달려야 되돌아갈 수 있다.","type":"transit","subzone":"어스름 층","gx":3,"gy":6,"size":"M","flags":[],"exits":[{"to":"for_dusk_2","gate":"none","dir":"R"},{"to":"min_lower_breach","gate":"벽달리기","dir":"U","note":"광산으로 되오르는 복귀로"}]},
    {"id":"for_dusk_3","name_kr":"갈림 덤불","concept":"길이 세 갈래로 찢어지는 덤불. 잘못 든 길이 늘 조금 더 어둡다.","type":"field","subzone":"어스름 층","gx":5,"gy":7,"size":"M","flags":[],"exits":[{"to":"for_dusk_2","gate":"none","dir":"U"},{"to":"for_black_gate","gate":"none","dir":"D"},{"to":"for_hollow_log","gate":"비밀","dir":"R"}]},
    {"id":"for_hollow_log","name_kr":"속 빈 큰나무","concept":"쓰러진 거목의 속 — 누군가 살다 간 흔적. 등잔·담요·아이의 그림이 남아 있다.","type":"secret","subzone":"어스름 층","gx":6,"gy":7,"size":"S","flags":["warm"],"exits":[{"to":"for_dusk_3","gate":"none","dir":"L"}]},
    {"id":"for_black_gate","name_kr":"칠흑 문","concept":"'빛 없이 들어간 자, 돌아오지 않았다' — 경고판 너머로 완전한 어둠이 시작된다.","type":"transit","subzone":"칠흑 층","gx":5,"gy":8,"size":"S","flags":[],"exits":[{"to":"for_dusk_3","gate":"none","dir":"U"},{"to":"for_black_1","gate":"none","dir":"D"}]},
    {"id":"for_black_1","name_kr":"칠흑 층","concept":"램프 반경이 세계의 전부가 되는 어둠. 매복 기믹의 본격 구간.","type":"field","subzone":"칠흑 층","gx":5,"gy":9,"size":"L","flags":[],"exits":[{"to":"for_black_gate","gate":"none","dir":"U"},{"to":"for_ambush_king","gate":"none","dir":"D"}]},
    {"id":"for_ambush_king","name_kr":"그림자 목구멍","concept":"미니보스 — 어둠 그 자체처럼 웅크린 큰 빛꺼림. 램프를 빼앗으려 든다.","type":"miniboss","subzone":"칠흑 층","gx":5,"gy":10,"size":"L","flags":[],"exits":[{"to":"for_black_1","gate":"none","dir":"U"},{"to":"for_black_2","gate":"none","dir":"D"}]},
    {"id":"for_black_2","name_kr":"숨죽인 골짜기","concept":"추격 응용 구간 — 빛이 꺼지면 달려야 한다. 골짜기 끝의 램프까지, 숨 한 번의 거리.","type":"field","subzone":"칠흑 층","gx":5,"gy":11,"size":"L","flags":[],"exits":[{"to":"for_ambush_king","gate":"none","dir":"U"},{"to":"for_black_3","gate":"none","dir":"R"},{"to":"for_firefly_gate","gate":"비밀","dir":"L"}]},
    {"id":"for_firefly_gate","name_kr":"반딧불 틈","concept":"바위 틈으로 반딧불이 강물처럼 흘러든다 — 따라가면 성소가 나온다.","type":"secret","subzone":"칠흑 층","gx":4,"gy":11,"size":"S","flags":[],"exits":[{"to":"for_black_2","gate":"none","dir":"R"},{"to":"for_firefly_sanctum","gate":"none","dir":"D"}]},
    {"id":"for_firefly_sanctum","name_kr":"반딧불 성소","concept":"숨은 거점 — 수천의 반딧불이 별하늘을 대신하는 방. 숲에서 가장 밝고 가장 조용한 곳.","type":"bench","subzone":"칠흑 층","gx":4,"gy":12,"size":"M","flags":["bench","warm"],"exits":[{"to":"for_firefly_gate","gate":"none","dir":"U"}]},
    {"id":"for_black_3","name_kr":"눈알 덤불","concept":"어둠 속에서 눈들이 먼저 보이는 덤불 — 매복과 추격이 조합되는 구간.","type":"field","subzone":"칠흑 층","gx":6,"gy":11,"size":"M","flags":[],"exits":[{"to":"for_black_2","gate":"none","dir":"L"},{"to":"for_deep_gate","gate":"none","dir":"D"},{"to":"for_chase_run","gate":"none","dir":"R"}]},
    {"id":"for_chase_run","name_kr":"달아나는 길","concept":"격리된 추격 챌린지 — 꺼져가는 램프 하나로 끝까지. 완주하면 숲 사람들의 오래된 상.","type":"challenge","subzone":"칠흑 층","gx":7,"gy":11,"size":"L","flags":[],"exits":[{"to":"for_black_3","gate":"none","dir":"L"}]},
    {"id":"for_deep_gate","name_kr":"심부 문","concept":"씨앗 램프의 빛에만 반응해 열리는 뿌리의 문 — 벽달리기로 뿌리 벽을 달려 내려간다.","type":"transit","subzone":"심부","gx":6,"gy":12,"size":"M","flags":[],"exits":[{"to":"for_black_3","gate":"none","dir":"U"},{"to":"for_deep_1","gate":"벽달리기","dir":"D"}]},

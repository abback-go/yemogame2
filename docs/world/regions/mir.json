{
  "region_id": "mir",
  "name_kr": "거울의 도시",
  "element": "태양",
  "identity": "태양빛을 거울 배관으로 골목마다 배달하는 사막 도시 — 빛 퍼즐의 지역. 발판 각인이 연다. 로컬 스토리: '태양로가 흐려진다'.",
  "palette": "모래 백금색 + 거울의 은빛 섬광 + 그림자 골목의 청회색",
  "music": "햇빛처럼 쨍한 현악 + 거울이 꺾일 때마다 반짝이는 타악",
  "region_magic": [{"name":"광창(가칭)","effect":"모아 쏘는 태양빛의 창 — 어둠 속성 적에게 결정적, 거울에 반사되어 꺾인다"}],
  "boss_key_story": "그림자 골목 아이들의 심부름과 빛 관리국의 배관 수리를 돕다 보면 '태양로 인장'을 맡게 된다 — 흐려진 태양로의 대문은 인장 없이 열리지 않는다.",
  "region_state_change": "태양로가 다시 타오르며 그림자 골목에 사상 처음 빛이 들고, 광장과 태양로를 잇는 직통 승강기가 개방된다.",
  "unique_enemy": "볕도마뱀 — 빛을 받으면 수정처럼 굳어 무적이 되고, 그림자 속에서만 부드러워지는 역설의 적.",
  "local_loops": [
    "거울 대로에서 그림자 골목으로 일방 낙하 → 뒷계단(벽차기 질주)으로 상층 시가 복귀 (§5.5의 내부 루프)",
    "보스 후 직통 승강기: 태양로 심장↔중앙 광장",
    "지하 수로 수문 개방 → 광산 서단으로 이어지는 외부 루프(월드 루프 ⑤ 보조)"
  ],
  "rooms": [
    {"id":"mir_gate_east","name_kr":"사막 관문","concept":"가도의 끝, 모래바람을 막는 이중문. 거울 각도 기믹이 처음 손에 잡히는 곳.","type":"transit","subzone":"관문","gx":11,"gy":4,"size":"M","flags":[],"exits":[{"to":"roa_desert_west","gate":"발판 각인","dir":"R"},{"to":"mir_gate_plaza","gate":"none","dir":"L"}]},
    {"id":"mir_gate_plaza","name_kr":"관문 안뜰","concept":"첫 거울들이 세워진 안뜰 — 빛을 꺾어 문을 여는 도입 퍼즐.","type":"field","subzone":"관문","gx":10,"gy":4,"size":"M","flags":[],"exits":[{"to":"mir_gate_east","gate":"none","dir":"R"},{"to":"mir_sun_road","gate":"none","dir":"L"}]},
    {"id":"mir_sun_road","name_kr":"태양 대로","concept":"빛 배관이 처음 머리 위로 지나가는 큰길. 배달되는 햇빛이 골목마다 쏟아진다.","type":"field","subzone":"관문","gx":8,"gy":4,"size":"L","flags":[],"exits":[{"to":"mir_gate_plaza","gate":"none","dir":"R"},{"to":"mir_plaza","gate":"none","dir":"L"},{"to":"mir_dune_lookout","gate":"비밀","dir":"U"}]},
    {"id":"mir_dune_lookout","name_kr":"모래 전망대","concept":"사구 너머 지평선까지 보이는 낡은 전망대. 노을 시간엔 도시 전체가 금빛이 된다.","type":"secret","subzone":"관문","gx":8,"gy":3,"size":"S","flags":["warm"],"exits":[{"to":"mir_sun_road","gate":"none","dir":"D"}]},

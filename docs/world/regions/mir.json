    {"id":"mir_bureau","name_kr":"빛 관리국","concept":"미니보스 — 폭주한 거울 골렘. 도시의 빛 배관을 관리하던 것이 빛에 굶주려 뒤틀렸다.","type":"miniboss","subzone":"관리국","gx":2,"gy":4,"size":"L","flags":[],"exits":[{"to":"mir_bureau_gate","gate":"none","dir":"R"},{"to":"mir_bureau_vault","gate":"none","dir":"U"}]},

    {"id":"mir_guild_row","name_kr":"세공 거리","concept":"거울 세공사들의 거리. 진열창마다 다른 각도의 하늘이 걸려 있다.","type":"town","subzone":"중앙","gx":6,"gy":3,"size":"M","flags":["shop"],"exits":[{"to":"mir_plaza","gate":"none","dir":"D"},{"to":"mir_atelier","gate":"none","dir":"L"}]},
    {"id":"mir_atelier","name_kr":"거울 공방","concept":"수석 세공사의 공방 — '태양로가 흐려진다'는 걱정이 처음 흘러나오는 곳.","type":"event","subzone":"중앙","gx":5,"gy":3,"size":"S","flags":[],"exits":[{"to":"mir_guild_row","gate":"none","dir":"R"}]},
    {"id":"mir_moon_site","name_kr":"그늘진 터","concept":"광장 뒤 늘 그늘인 공터 — 보름밤이면 달빛 장이 선다는 소문.","type":"event","subzone":"중앙","gx":6,"gy":5,"size":"S","flags":["moon_site"],"exits":[{"to":"mir_plaza","gate":"none","dir":"U"},{"to":"mkt_gate_mir","gate":"상태:보름밤","dir":"D"}]},

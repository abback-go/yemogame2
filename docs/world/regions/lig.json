    {"id":"lig_ranch_road","name_kr":"목장 길","concept":"울타리를 따라 걷는 길. 뇌우양들이 정전기 오른 털을 부풀리고 있다.","type":"field","subzone":"초지","gx":2,"gy":4,"size":"M","flags":[],"exits":[{"to":"lig_meadow_1","gate":"none","dir":"L"},{"to":"lig_village","gate":"none","dir":"R"}]},

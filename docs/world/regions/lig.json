    {"id":"lig_south_trail","name_kr":"남쪽 벼랑길","concept":"조수 도시 쪽으로 굽이치며 내려가는 벼랑길 — 바닷바람과 고원 바람이 만나는 곳.","type":"transit","subzone":"마을","gx":4,"gy":5,"size":"M","flags":[],"exits":[{"to":"lig_village","gate":"none","dir":"U"},{"to":"tid_cliff_north","gate":"활공","dir":"D"}]},

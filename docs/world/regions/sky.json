{
  "region_id": "sky",
  "name_kr": "바람이 시작되는 곳",
  "element": "바람 심화",
  "identity": "세계의 바람이 시작되는 부유 군도 — 최후반 지역. 기류 승월이 열고, 시계탑과 폭풍 두 개의 하늘길이 닿는다.",
  "palette": "새벽하늘의 담청·연보라 + 구름의 흰색 + 섬 밑면의 젖은 바위색",
  "music": "높은 목관과 성가풍 허밍 — 바람이 화음을 이룬다",
  "region_magic": [{"name":"기류 부름(가칭)","effect":"그 자리에 상승기류 기둥을 세운다 — 이동과 전투(띄우기)를 겸하는 바람 심화 마법"}],
  "boss_key_story": "순례자 야영지의 오래된 약속 — '가장 높은 곳은 바람이 허락한 자에게만'. 세 바람 사당에 예를 갖추면 마지막 기류가 열린다.",
  "region_state_change": "시험을 마치면 군도의 기류가 온화해져 섬 사이 이동이 쉬워지고, 세계 전체가 보이는 자리가 열린다.",
  "unique_enemy": "구름송곳 — 구름 속에 숨어 있다가 기류를 타고 내리꽂는 급습형. 그림자가 유일한 예고다.",
  "local_loops": [

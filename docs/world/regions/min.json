{
  "region_id": "min",
  "name_kr": "거인의 광산",
  "element": "대지",
  "identity": "화석이 된 태고 거인의 몸을 파 내려가는 광산 — 마력석의 산지이자 세계의 길찾기 미로. 공중 질풍보가 여는 첫 대지역.",
  "palette": "황토·뼈의 상아색 + 갱도 램프의 주황 점들",
  "music": "곡괭이 리듬과 낮은 울림 — 심부로 갈수록 심장박동 같은 저음이 섞인다",
  "region_magic": [{"name":"융기(가칭)","effect":"발밑에서 돌기둥을 솟구쳐 적을 띄우고 낮은 발판이 된다 — 무겁고 결정적인 지역 마법"}],
  "boss_key_story": "입구 캠프의 노광부 일을 돕다 보면 '거인을 달래는 자장가'(진동의 리듬)를 배운다 — 그 리듬 없이 심장 방 문은 열리지 않는다.",
  "region_state_change": "심장의 맥동이 잦아들어 무너지던 갱도가 안정되고, 열기 통로(가마 마을행)와 수레 레일 전 구간이 개방된다.",
  "unique_enemy": "잠꼬대 굴착꾼 — 평소엔 화석처럼 잠들어 있다가 소리(공격·달리기)에 깨어나는 석상형.",
  "local_loops": [
    "권양기를 수리하면 잊힌 레일 구간이 열려 심부↔입구 캠프 직통 지름길이 된다",
    "뼈의 미로 가짜 출구가 사실 상부 갱도로 되돌아오는 낙하 지름길",
    "언 갱도·수문·열기 통로 — 이웃 지역들로 향하는 뒷문 셋이 전부 나중에 열리는 외부 루프"
  ],
  "rooms": [
    {"id":"min_old_gate","name_kr":"갱도 문턱","concept":"정수장의 옛 갱도 문 너머, 광산 쪽 문턱. 여기부터 공기에 돌가루 맛이 난다.","type":"transit","subzone":"입구 캠프","gx":6,"gy":0,"size":"M","flags":[],"exits":[{"to":"sch_cistern_deep","gate":"none","dir":"U"},{"to":"min_camp","gate":"none","dir":"D"}]},
    {"id":"min_camp","name_kr":"입구 캠프","concept":"광부들의 천막과 화덕. 노광부가 신입에게 갱도의 예절을 가르친다 — 지역 지도 입수처.","type":"town","subzone":"입구 캠프","gx":6,"gy":1,"size":"L","flags":["bench","map","shop"],"exits":[{"to":"min_old_gate","gate":"none","dir":"U"},{"to":"min_camp_gate","gate":"none","dir":"L"},{"to":"min_toolshed","gate":"none","dir":"R"},{"to":"min_upper_1","gate":"none","dir":"D"},{"to":"min_forgotten_rail","gate":"상태:권양기 수리","dir":"D","note":"수리 후 열리는 직통 지름길"}]},
    {"id":"min_camp_gate","name_kr":"지상 문","concept":"광산이 지상의 옛 가도와 만나는 문. 수레 바큇자국이 서쪽으로 이어진다.","type":"transit","subzone":"입구 캠프","gx":4,"gy":1,"size":"S","flags":[],"exits":[{"to":"min_camp","gate":"none","dir":"R"},{"to":"roa_mine_trail","gate":"none","dir":"L"}]},
    {"id":"min_toolshed","name_kr":"장비고","concept":"곡괭이·램프·밧줄이 걸린 창고. 광부 조합의 소소한 의뢰가 붙는다.","type":"town","subzone":"입구 캠프","gx":7,"gy":1,"size":"S","flags":["shop"],"exits":[{"to":"min_camp","gate":"none","dir":"L"}]},
    {"id":"min_upper_1","name_kr":"버팀목 갱도","concept":"거인의 갈빗대를 버팀목 삼은 상부 갱도. 첫 광맥과 첫 매복이 함께 있다.","type":"field","subzone":"상부 갱도","gx":6,"gy":2,"size":"M","flags":[],"exits":[{"to":"min_camp","gate":"none","dir":"U"},{"to":"min_rail_st","gate":"none","dir":"L"},{"to":"min_dust_hall","gate":"none","dir":"R"}]},
    {"id":"min_rail_st","name_kr":"수레 정거장","concept":"폐선 수레 레일의 광산 쪽 종점. 레일이 다시 달리면 세계의 서쪽이 가까워진다.","type":"transit","subzone":"상부 갱도","gx":4,"gy":2,"size":"M","flags":["rail"],"exits":[{"to":"min_upper_1","gate":"none","dir":"R"},{"to":"min_upper_2","gate":"none","dir":"D"}]},
    {"id":"min_upper_2","name_kr":"수레 나들목","concept":"수레를 타고 갈라지는 갱도들을 익히는 구간 — 이 지역 이동 트릭의 도입부.","type":"field","subzone":"상부 갱도","gx":4,"gy":3,"size":"M","flags":[],"exits":[{"to":"min_rail_st","gate":"none","dir":"U"},{"to":"min_winch","gate":"none","dir":"L"},{"to":"min_maze_gate","gate":"공중 질풍보","dir":"D","note":"끊긴 다리 — 미로로 내려가는 관문"}]},
    {"id":"min_winch","name_kr":"권양기 방","concept":"멈춘 권양기와 끊긴 승강 케이블. 부품을 모아 수리하면 잊힌 레일이 깨어난다.","type":"event","subzone":"상부 갱도","gx":3,"gy":3,"size":"M","flags":[],"exits":[{"to":"min_upper_2","gate":"none","dir":"R"},{"to":"min_cart_run","gate":"none","dir":"L"}]},
    {"id":"min_cart_run","name_kr":"수레 질주로","concept":"격리된 수레 질주 챌린지 — 갈림길마다 레버를 젖혀 완주하면 광부들의 상금이 걸려 있다.","type":"challenge","subzone":"상부 갱도","gx":2,"gy":3,"size":"L","flags":[],"exits":[{"to":"min_winch","gate":"none","dir":"R"}]},
    {"id":"min_dust_hall","name_kr":"먼지 홀","concept":"발소리가 먼지를 일으키는 넓은 홀 — 잠꼬대 굴착꾼이 처음 등장하는 안전한 소개 방.","type":"field","subzone":"상부 갱도","gx":8,"gy":2,"size":"L","flags":[],"exits":[{"to":"min_upper_1","gate":"none","dir":"L"},{"to":"min_echo_gallery","gate":"none","dir":"D"},{"to":"min_frozen_adit","gate":"none","dir":"R"}]},
    {"id":"min_echo_gallery","name_kr":"울림 회랑","concept":"소리가 벽을 타고 달리는 회랑. 조용히 걷는 법을 배우는 응용 구간.","type":"field","subzone":"상부 갱도","gx":8,"gy":3,"size":"M","flags":[],"exits":[{"to":"min_dust_hall","gate":"none","dir":"U"},{"to":"min_vein_1","gate":"공중 질풍보","dir":"D","note":"끊긴 발판 — 공중 질풍보 게이트"}]},
    {"id":"min_frozen_adit","name_kr":"얼어붙은 막장","concept":"얼음이 벽을 타고 내려온 북쪽 막장 — 위쪽 어딘가와 이어져 있지만 얼음 너머는 보이지 않는다.","type":"transit","subzone":"상부 갱도","gx":10,"gy":2,"size":"M","flags":[],"exits":[{"to":"min_dust_hall","gate":"none","dir":"L"},{"to":"bel_adit_south","gate":"상태:언 갱도 개통","dir":"U","note":"종의 계곡 쪽에서 얼음을 깨면 열린다"}]},
    {"id":"min_maze_gate","name_kr":"미로 어귀","concept":"'여기부터 지도가 그려지지 않는다' — 광부들의 경고판. 표식을 직접 남겨야 하는 구간의 시작.","type":"field","subzone":"뼈의 미로","gx":4,"gy":4,"size":"M","flags":[],"exits":[{"to":"min_upper_2","gate":"none","dir":"U"},{"to":"min_maze_rib","gate":"none","dir":"D"}]},
    {"id":"min_maze_rib","name_kr":"갈비뼈 회랑","concept":"거인의 갈비뼈 사이로 갈라지는 길들. 어느 뼈나 똑같이 생겼다.","type":"field","subzone":"뼈의 미로","gx":4,"gy":5,"size":"L","flags":[],"exits":[{"to":"min_maze_gate","gate":"none","dir":"U"},{"to":"min_maze_spine","gate":"none","dir":"R"},{"to":"min_maze_marrow","gate":"비밀","dir":"L"}]},
    {"id":"min_maze_marrow","name_kr":"골수 굴","concept":"갈비뼈 안쪽의 숨은 굴 — 마력석이 가장 굵게 맺히는 부광맥.","type":"secret","subzone":"뼈의 미로","gx":3,"gy":5,"size":"S","flags":[],"exits":[{"to":"min_maze_rib","gate":"none","dir":"R"}]},
    {"id":"min_maze_spine","name_kr":"등뼈 교차로","concept":"미로의 중심 — 여섯 갈래가 만난다. 바닥의 옛 표식은 절반이 지워져 있다.","type":"field","subzone":"뼈의 미로","gx":5,"gy":5,"size":"L","flags":[],"exits":[{"to":"min_maze_rib","gate":"none","dir":"L"},{"to":"min_maze_false","gate":"none","dir":"U"},{"to":"min_bone_shrine","gate":"비밀","dir":"R"},{"to":"min_maze_exit","gate":"none","dir":"D"}]},
    {"id":"min_maze_false","name_kr":"가짜 출구","concept":"빛이 드는 줄 알았던 구멍 — 상부 갱도로 떨어지는 낙하 지름길이었다. 미로의 짓궂은 농담.","type":"transit","subzone":"뼈의 미로","gx":5,"gy":4,"size":"S","flags":[],"exits":[{"to":"min_maze_spine","gate":"none","dir":"D"},{"to":"min_upper_1","gate":"none","dir":"U","oneway":true,"note":"일방 낙하 — 내부 루프"}]},
    {"id":"min_bone_shrine","name_kr":"뼈 사당","concept":"광부들이 거인에게 절하는 오래된 사당. 촛농이 수백 년 치 쌓여 있다.","type":"secret","subzone":"뼈의 미로","gx":6,"gy":5,"size":"S","flags":["warm"],"exits":[{"to":"min_maze_spine","gate":"none","dir":"L"}]},
    {"id":"min_maze_exit","name_kr":"미로 남단","concept":"미로를 벗어나면 벽의 색이 변한다 — 여기서부터 굳은 핏줄, 광산의 진짜 속살.","type":"field","subzone":"뼈의 미로","gx":5,"gy":6,"size":"M","flags":[],"exits":[{"to":"min_maze_spine","gate":"none","dir":"U"},{"to":"min_vein_1","gate":"none","dir":"R"},{"to":"min_west_end","gate":"none","dir":"L"}]},
    {"id":"min_west_end","name_kr":"서단 수로","concept":"물소리가 벽 너머에서 들리는 서쪽 끝 — 수문이 잠겨 있다. 열쇠는 사막의 도시 쪽에 있다.","type":"transit","subzone":"뼈의 미로","gx":2,"gy":6,"size":"M","flags":[],"exits":[{"to":"min_maze_exit","gate":"none","dir":"R"},{"to":"mir_waterway_east","gate":"상태:수문 개방","dir":"L"}]},
    {"id":"min_vein_1","name_kr":"굳은 핏줄 광맥","concept":"거인의 혈관이 광맥이 된 구간. 붉은 결이 램프 빛에 맥박처럼 일렁인다.","type":"field","subzone":"굳은 핏줄","gx":7,"gy":6,"size":"L","flags":[],"exits":[{"to":"min_maze_exit","gate":"none","dir":"L"},{"to":"min_echo_gallery","gate":"none","dir":"U"},{"to":"min_vein_2","gate":"공중 질풍보","dir":"D"}]},
    {"id":"min_vein_2","name_kr":"맥박 광층","concept":"발디딜 곳이 끊겨 공중 질풍보 없이는 건널 수 없는 광층. 벽이 미세하게 두근거린다.","type":"field","subzone":"굳은 핏줄","gx":7,"gy":7,"size":"M","flags":[],"exits":[{"to":"min_vein_1","gate":"공중 질풍보","dir":"U"},{"to":"min_vein_camp","gate":"none","dir":"L"},{"to":"min_lower_breach","gate":"none","dir":"R"}]},
    {"id":"min_vein_camp","name_kr":"광부 야영지","concept":"심부 광부들의 간이 야영지 — 두 번째 거점. 여기서부터는 램프도 아껴 켠다.","type":"bench","subzone":"굳은 핏줄","gx":6,"gy":7,"size":"M","flags":["bench"],"exits":[{"to":"min_vein_2","gate":"none","dir":"R"},{"to":"min_crush_arena","gate":"none","dir":"D"},{"to":"min_forgotten_rail","gate":"상태:권양기 수리","dir":"U"}]},
    {"id":"min_lower_breach","name_kr":"무너진 하부","concept":"바닥이 숲으로 꺼져 내린 붕괴 지점 — 뛰어내릴 수는 있지만 돌아올 수는 없다.","type":"transit","subzone":"굳은 핏줄","gx":8,"gy":7,"size":"M","flags":[],"exits":[{"to":"min_vein_2","gate":"none","dir":"L"},{"to":"for_west_roots","gate":"벽차기 질주","dir":"D","oneway":true,"note":"일방 낙하 — 벽 제어 없이는 진입 불가(조기 고립 방지). 잠들지 않는 숲으로"}]},
    {"id":"min_crush_arena","name_kr":"무너지는 홀","concept":"천장이 반쯤 내려앉은 홀 — 미니보스 '무너뜨리는 자'가 길을 막는다(웹 프로토타입 계승).","type":"miniboss","subzone":"굳은 핏줄","gx":6,"gy":8,"size":"L","flags":[],"exits":[{"to":"min_vein_camp","gate":"none","dir":"U"},{"to":"min_deep_shaft","gate":"none","dir":"D"}]},
    {"id":"min_deep_shaft","name_kr":"심부 수직굴","concept":"거인의 심장으로 내려가는 마지막 수직굴. 공중 질풍보로 벽 사이를 지그재그로 딛는다.","type":"field","subzone":"심장부","gx":6,"gy":9,"size":"M","flags":[],"exits":[{"to":"min_crush_arena","gate":"none","dir":"U"},{"to":"min_heart_gate","gate":"none","dir":"D"},{"to":"min_gem_hollow","gate":"비밀","dir":"R"}]},
    {"id":"min_gem_hollow","name_kr":"정동(晶洞) 굴","concept":"수정이 별처럼 박힌 빈 굴 — 광산에서 가장 조용하고 가장 아름다운 방.","type":"secret","subzone":"심장부","gx":7,"gy":9,"size":"S","flags":["warm"],"exits":[{"to":"min_deep_shaft","gate":"none","dir":"L"}]},
    {"id":"min_heart_gate","name_kr":"심장 앞 등불","concept":"보스 앞 거점. 광부들이 남긴 등불이 줄지어 심장 방을 가리킨다.","type":"bench","subzone":"심장부","gx":6,"gy":10,"size":"M","flags":["bench"],"exits":[{"to":"min_deep_shaft","gate":"none","dir":"U"},{"to":"min_giant_eye","gate":"none","dir":"L"},{"to":"min_heart","gate":"열쇠:거인의 자장가","dir":"D"}]},
    {"id":"min_giant_eye","name_kr":"거인의 눈꺼풀","concept":"감긴 거인의 눈을 정면으로 마주보는 선반 — 이 광산이 '몸'임을 처음 실감하는 곳.","type":"event","subzone":"심장부","gx":5,"gy":10,"size":"S","flags":["warm"],"exits":[{"to":"min_heart_gate","gate":"none","dir":"R"}]},
    {"id":"min_heart","name_kr":"심장 방","concept":"보스전 — 꿈꾸는 거인의 심장. '깨우지 않으며' 치르는 전투: 소음·진동을 관리하는 기믹의 졸업시험.","type":"boss","subzone":"심장부","gx":6,"gy":11,"size":"XL","flags":[],"exits":[{"to":"min_heart_gate","gate":"none","dir":"U"},{"to":"min_heart_pass","gate":"상태:광산 심장 안정","dir":"R"}]},
    {"id":"min_heart_pass","name_kr":"열기 통로","concept":"심장이 잠잠해진 뒤 열리는 뜨거운 통로 — 이 열기가 가마 마을의 가마를 데운다.","type":"transit","subzone":"심장부","gx":8,"gy":11,"size":"M","flags":[],"exits":[{"to":"min_heart","gate":"none","dir":"L"},{"to":"kil_heat_gate","gate":"none","dir":"R"}]},
    {"id":"min_forgotten_rail","name_kr":"잊힌 레일 구간","concept":"권양기 수리로 깨어나는 직통 레일 — 심부에서 입구 캠프까지 한달음의 내부 루프.","type":"transit","subzone":"굳은 핏줄","gx":5,"gy":7,"size":"M","flags":[],"exits":[{"to":"min_camp","gate":"none","dir":"U"},{"to":"min_vein_camp","gate":"none","dir":"D"}]}
  ]
}
